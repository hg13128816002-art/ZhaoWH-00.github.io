---
import geometrySource from '../scripts/opening/z-loading.js?raw';
import rendererSource from '../scripts/page-transition-renderer.js?raw';
import controllerSource from '../scripts/page-transition.js?raw';

const { skipInitialReveal = false } = Astro.props;
// Inline this small runtime so a new document paints the carried-over Z phase synchronously.
const runtime = [geometrySource, rendererSource, controllerSource]
  .map(source => source.replace(/^export /gm, '')).join('\n');
---

<div id="diy-transition-gate" data-page-transition data-skip-initial={String(skipInitialReveal)} hidden={skipInitialReveal} aria-hidden="true">
  <svg viewBox="0 0 1280 534" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"></svg>
</div>
<script is:inline set:html={`(() => {
${runtime}
const root = document.getElementById('diy-transition-gate');
initPageTransition(root, createPageTransitionRenderer(root, createZLoadingGeometry()));
})();`} />
<noscript><style>#diy-transition-gate { display: none !important; }</style></noscript>

<style>
  #diy-transition-gate {
    position: fixed; inset: 0; z-index: 10080;
    width: 100%; height: 100%; overflow: hidden;
    pointer-events: auto; user-select: none;
    visibility: visible !important;
    background: #040A10;
    contain: layout paint;
  }
  #diy-transition-gate[data-renderer-ready="true"] { background: transparent; }
  #diy-transition-gate[hidden] { display: none !important; }
  #diy-transition-gate svg { display: block; width: 100%; height: 100%; }
</style>
