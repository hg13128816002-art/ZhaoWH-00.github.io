---
// Geometry is derived from the archived Opening 37; the archive stays immutable.
---
<div class="hero-opening" data-hero-opening-root data-state="loading" aria-label="Zhao Wenhao 开场动画">
  <svg class="zo-stage" viewBox="0 0 1280 534" aria-hidden="true" focusable="false">
    <defs>
      <g id="zo-glyph-Z"><path data-wordmark-z /></g>
      <g id="zo-glyph-h"><path data-diagonal-glyph="h" /></g>
      <g id="zo-glyph-a"><path data-diagonal-glyph="a" fill-rule="evenodd" /></g>
      <g id="zo-glyph-o"><path data-diagonal-glyph="o" fill-rule="evenodd" /></g>
      <g id="zo-glyph-W"><path d="M0 -64H7L20 -11L32 -52H38L50 -11L63 -64H70L54 0H47L35 -41L23 0H16Z" /></g>
      <g id="zo-glyph-e"><path data-diagonal-glyph="e" /></g>
      <g id="zo-glyph-n"><path data-diagonal-glyph="n" /></g>
      <g id="zo-glyph-H"><path d="M0 0V-64H7V-31H39V-64H46V0H39V-24H7V0Z" /></g>
      <g id="zo-glyph-F"><path d="M0 0V-64H38V-57H7V-34H30V-27H7V0Z" /></g>
      <g id="zo-glyph-T"><path d="M0 -64H42V-57H24.5V0H17.5V-57H0Z" /></g>
      <g id="zo-glyph-E"><path d="M0 -64H38V-57H7V-36H31V-29H7V-7H38V0H0Z" /></g>
      <g id="zo-glyph-r"><path data-diagonal-glyph="r" /></g>
      <g id="zo-glyph-g"><path data-diagonal-glyph="g" fill-rule="evenodd" /></g>
      <g id="zo-glyph-d"><path data-diagonal-glyph="d" fill-rule="evenodd" /></g>
      <g id="zo-glyph-x"><path data-diagonal-glyph="x" /></g>
      <g id="zo-glyph-t"><path d="M7 -55H14V-42H26V-35H14V-7H26V0H7V-35H0V-42H7Z" /></g>
      <g id="zo-glyph-i"><path d="M0 -42H7V0H0Z M0 -56H7V-49H0Z" /></g>
      <g id="zo-glyph-y"><path d="M0 -42H7L20 -12L33 -42H40L16 18H8L16 -2Z" /></g>
      <g id="zo-glyph-M"><path data-diagonal-glyph="M" /></g>
      <g id="zo-glyph-k"><path data-diagonal-glyph="k" /></g>
      <g id="zo-glyph-s"><path data-diagonal-glyph="s" /></g>
      <g id="zo-glyph-m"><path data-diagonal-glyph="m" /></g>
      <g id="zo-glyph-f"><path data-diagonal-glyph="f" /></g>
      <g id="zo-glyph-period"><path d="M0 -7H7V0H0Z" /></g>
      <g id="zo-glyph-hash"><path d="M10 -64H17V0H10Z M29 -64H36V0H29Z M0 -45H46V-38H0Z M0 -26H46V-19H0Z" /></g>
      <g id="zo-glyph-ampersand"><path d="M43 -3L11 -39L8 -46V-54L15 -61H26L33 -54V-45L5 -19V-10L12 -3H25L44 -24" fill="none" stroke="currentColor" stroke-width="7" stroke-linejoin="miter" /></g>
      <g id="zo-glyph-plus"><path d="M0 -36H38V-29H0Z M15.5 -51H22.5V-13H15.5Z" /></g>
      <g id="zo-glyph-question"><path d="M0 -51L12 -64H34V-36L21 -23V-13H14V-27L27 -40V-57H15L7 -49V-43H0Z M14 -7H21V0H14Z" /></g>
      <g id="zo-glyph-slash"><path data-diagonal-glyph="/" /></g>
      <g id="zo-glyph-equals"><path d="M0 -43H38V-36H0Z M0 -25H38V-18H0Z" /></g>

      <clipPath id="zo-hao-clip" clipPathUnits="userSpaceOnUse"><rect data-reveal="hao" x="0" y="-90" width="0" height="125" /></clipPath>
      <clipPath id="zo-en-clip" clipPathUnits="userSpaceOnUse"><rect data-reveal="en" x="0" y="-90" width="0" height="125" /></clipPath>
      <clipPath id="zo-ao-clip" clipPathUnits="userSpaceOnUse"><rect data-reveal="ao" x="0" y="-90" width="0" height="125" /></clipPath>
      <clipPath id="zo-collage-window" clipPathUnits="userSpaceOnUse"><rect data-collage-window x="0" y="0" width="1280" height="534" /></clipPath>
      <clipPath id="zo-row-window-0" clipPathUnits="userSpaceOnUse"><rect data-row-window="0" x="0" y="0" width="1280" height="534" /></clipPath>
      <clipPath id="zo-row-window-1" clipPathUnits="userSpaceOnUse"><rect data-row-window="1" x="0" y="0" width="1280" height="534" /></clipPath>
      <clipPath id="zo-row-window-2" clipPathUnits="userSpaceOnUse"><rect data-row-window="2" x="0" y="0" width="1280" height="534" /></clipPath>
      <clipPath id="zo-row-window-3" clipPathUnits="userSpaceOnUse"><rect data-row-window="3" x="0" y="0" width="1280" height="534" /></clipPath>
      <clipPath id="zo-row-window-4" clipPathUnits="userSpaceOnUse"><rect data-row-window="4" x="0" y="0" width="1280" height="534" /></clipPath>
      <clipPath id="zo-row-window-5" clipPathUnits="userSpaceOnUse"><rect data-row-window="5" x="0" y="0" width="1280" height="534" /></clipPath>
      <mask id="zo-intact" maskUnits="userSpaceOnUse" x="0" y="0" width="1280" height="534" style="mask-type:luminance">
        <rect x="0" y="0" width="1280" height="534" fill="white" />
        <rect data-hole="0" x="0" y="0" width="1280" height="0" fill="black" />
        <rect data-hole="1" x="0" y="0" width="1280" height="0" fill="black" />
        <rect data-hole="2" x="0" y="0" width="1280" height="0" fill="black" />
      </mask>
      <clipPath id="zo-slice-0" clipPathUnits="userSpaceOnUse"><rect data-slice-clip="0" x="0" y="0" width="1280" height="0" /></clipPath>
      <clipPath id="zo-slice-1" clipPathUnits="userSpaceOnUse"><rect data-slice-clip="1" x="0" y="0" width="1280" height="0" /></clipPath>
      <clipPath id="zo-slice-2" clipPathUnits="userSpaceOnUse"><rect data-slice-clip="2" x="0" y="0" width="1280" height="0" /></clipPath>

      <g id="zo-frame-art" fill="currentColor">
        <g data-phrase-scene>
          <g data-phrase-word="Make"></g>
          <g data-phrase-word="something"></g>
          <g data-phrase-word="different."></g>
        </g>
        <g data-collage-scene visibility="hidden" clip-path="url(#zo-collage-window)">
          <g clip-path="url(#zo-row-window-0)"><g data-collage-row="0"></g></g>
          <g clip-path="url(#zo-row-window-1)"><g data-collage-row="1"></g></g>
          <g clip-path="url(#zo-row-window-2)"><g data-collage-row="2"></g></g>
          <g clip-path="url(#zo-row-window-3)"><g data-collage-row="3"></g></g>
          <g clip-path="url(#zo-row-window-4)"><g data-collage-row="4"></g></g>
          <g clip-path="url(#zo-row-window-5)"><g data-collage-row="5"></g></g>
        </g>
        <g data-detail-scene fill="none" stroke="currentColor" stroke-width="1" />
        <!-- The approved Z and slogan keep their 640 × 360 geometry.
             The final wordmark appears complete, with a subtle shared camera shake. -->
        <g data-closing-scene visibility="hidden" transform="translate(256 51) scale(1.2)">
          <g data-logo-scene>
            <g data-logo-placement transform="translate(320 180)">
              <path data-logo fill="currentColor" />
            </g>
            <g data-slogan fill="currentColor" opacity="0">
              <g data-slogan-line="0"><g data-glyph-content="Forge" /></g>
              <g data-slogan-line="1"><g data-glyph-content="The" /></g>
              <g data-slogan-line="2"><g data-glyph-content="Extraordinary" /></g>
            </g>
          </g>
          <g data-name-scene fill="currentColor" visibility="hidden">
            <g data-name-layout>
              <g data-word="Z"><g data-glyph-content="Z" /></g>
              <g data-word="hao" opacity="0"><g clip-path="url(#zo-hao-clip)"><g data-glyph-content="hao" /></g></g>
              <g data-word="W"><g data-glyph-content="W" /></g>
              <g data-word="en" opacity="0"><g clip-path="url(#zo-en-clip)"><g data-glyph-content="en" /></g></g>
              <g data-word="H"><g data-glyph-content="H" /></g>
              <g data-word="ao" opacity="0"><g clip-path="url(#zo-ao-clip)"><g data-glyph-content="ao" /></g></g>
            </g>
          </g>
        </g>
      </g>
    </defs>
    <g data-picture>
      <rect data-background x="0" y="0" width="1280" height="534" fill="#040A10" />
      <g data-ink color="#ACDBFB" fill="currentColor">
        <g mask="url(#zo-intact)"><use href="#zo-frame-art" /></g>
        <g clip-path="url(#zo-slice-0)"><use data-slice-copy="0" href="#zo-frame-art" /></g>
        <g clip-path="url(#zo-slice-1)"><use data-slice-copy="1" href="#zo-frame-art" /></g>
        <g clip-path="url(#zo-slice-2)"><use data-slice-copy="2" href="#zo-frame-art" /></g>
      </g>
    </g>
    <g data-loading-scene visibility="hidden" color="#ACDBFB" fill="currentColor" aria-label="Z 沙漏载入动画">
      <g data-loading-gates />
      <g data-loading-mark transform="translate(640 267)">
        <g data-loading-rotor>
          <g data-loading-trails aria-hidden="true" />
          <g data-loading-top />
          <g data-loading-bottom />
          <path data-loading-diagonal />
          <path data-loading-stream fill="none" stroke="currentColor" stroke-width="4" stroke-dasharray="7 17" />
          <path data-loading-intact />
        </g>
      </g>
    </g>
    <g data-outro-scene visibility="hidden" color="#ACDBFB" fill="currentColor" aria-label="姓名 Z 斜切转场">
      <g data-next-content />
      <g data-outro-gates />
      <path data-outro-mark />
    </g>
  </svg>
  <!-- Fade 21.3–23.7 s to silence; retain the original 24.624 s length and musical cues. -->
  <audio data-opening-audio preload="auto" src="/opening/z-opening-37.mp3?v=fade-2400-v2"></audio>
  <button class="opening-start" type="button" data-opening-start hidden>
    <span aria-hidden="true">▶</span><span data-opening-start-label>播放开场 · 开启声音</span>
  </button>
  <span class="opening-status" data-opening-status role="status" aria-live="polite"></span>
</div>
<div class="opening-controls" data-opening-controls hidden>
  <button class="opening-control opening-sound" type="button" data-opening-sound data-enabled="false" aria-label="打开声音" title="打开声音" aria-pressed="false">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
      <path d="M11 5 6 9H3v6h3l5 4Z" />
      <g class="sound-on"><path d="M15 8a6 6 0 0 1 0 8M18 5a10 10 0 0 1 0 14" /></g>
      <path class="sound-off" d="m16 9 5 6m0-6-5 6" />
    </svg>
  </button>
  <button class="opening-control opening-pause" type="button" data-opening-pause data-paused="false" aria-label="暂停开场动画" title="暂停开场动画">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
      <g class="pause-icon"><rect x="7" y="5" width="3" height="14" /><rect x="14" y="5" width="3" height="14" /></g>
      <path class="play-icon" d="m8 5 11 7-11 7Z" />
    </svg>
  </button>
</div>
<dialog class="opening-consent" data-opening-consent aria-labelledby="opening-consent-title">
  <div class="opening-consent-content">
    <h2 id="opening-consent-title" tabindex="-1" autofocus>是否允许本网页播放声音？</h2>
    <div class="opening-consent-actions">
      <button type="button" data-opening-deny>不允许</button>
      <button type="button" data-opening-allow>允许</button>
    </div>
  </div>
</dialog>
<noscript><style>.hero-opening, .opening-controls { display: none !important; }</style></noscript>

<style>
  .hero-opening {
    position: fixed;
    inset: 0 0 auto;
    width: 100%;
    height: var(--hero-canvas-height, 75svh);
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    contain: layout paint;
  }
  .hero-opening .zo-stage { display: block; width: 100%; height: 100%; overflow: hidden; color: #ACDBFB; }
  .hero-opening[data-state="loading"],
  .hero-opening[data-state="consent"] { background: #040a10; }
  .hero-opening[data-revealed="true"] .zo-stage { opacity: 0; }
  :global(html[data-opening-consent="true"]),
  :global(html[data-opening-consent="true"] body) { overflow: hidden !important; }
  .opening-consent {
    position: fixed; inset: 0; margin: 0;
    width: 100%; height: 100%; max-width: none; max-height: none;
    padding: max(1.5rem, env(safe-area-inset-top)) 1.5rem;
    border: 0; background: transparent; color: #e8f3fd;
    overflow: auto; overscroll-behavior: contain;
  }
  .opening-consent[open] { display: grid; place-items: center; }
  .opening-consent::backdrop {
    background: rgba(4, 10, 16, 0.48);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
  }
  .opening-consent-content { width: min(100%, 34rem); text-align: center; transform: translateY(-1.75rem); }
  .opening-consent h2 {
    margin: 0; font-size: 1.0625rem;
    font-weight: 500; line-height: 1.5; letter-spacing: 0.04em;
  }
  .opening-consent h2:focus { outline: none; }
  .opening-consent-actions { display: flex; justify-content: center; gap: 2rem; margin-top: 2.25rem; }
  .opening-consent button {
    flex: 1; max-width: 9rem; min-height: 44px; padding: 0.625rem 0.875rem;
    border: 1px solid #acdbfb; background: rgba(4, 10, 16, 0.2);
    color: #e8f3fd; font: inherit; font-size: 0.9rem; cursor: pointer;
    transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;
  }
  .opening-consent [data-opening-allow] { background: rgba(172, 219, 251, 0.55); color: #040a10; }
  @media (hover: hover) {
    .opening-consent button:hover {
      background: #acdbfb;
      color: #040a10;
      border-color: #acdbfb;
    }
  }
  .opening-consent button:focus-visible { outline: 2px solid #e8f3fd; outline-offset: 5px; }
  .opening-start {
    position: absolute;
    border: 1px solid #ACDBFB;
    color: #ACDBFB;
    background: #040a10;
    font: 500 0.8rem/1.4 "Helvetica Neue", Arial, sans-serif;
    cursor: pointer;
    pointer-events: auto;
  }
  .opening-start {
    left: 50%; bottom: clamp(1rem, 5%, 2.5rem); transform: translateX(-50%);
    display: flex; align-items: center; gap: 0.75rem;
    min-height: 44px; padding: 0.65rem 1.1rem; white-space: nowrap;
  }
  .opening-start:hover { background: #ACDBFB; color: #040a10; }
  .opening-start:focus-visible { outline: 2px solid #ACDBFB; outline-offset: 4px; }
  /* Blend outside the opening's paint containment, including after the canvas is revealed. */
  .opening-controls {
    position: fixed; z-index: 0;
    top: calc(var(--hero-canvas-height, 75svh) - 1rem - 44px);
    right: max(1rem, env(safe-area-inset-right));
    display: flex; gap: 4px;
    color: #ACDBFB; mix-blend-mode: difference;
  }
  .opening-control {
    display: grid; place-items: center;
    width: 44px; height: 44px; padding: 0;
    border: 0; border-radius: 0; background: transparent; box-shadow: none;
    color: inherit; cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: transform 180ms ease;
  }
  .opening-control svg { display: block; width: 20px; height: 20px; }
  .opening-control:focus-visible { outline: 1px solid currentColor; outline-offset: -4px; }
  .opening-sound[data-enabled="false"] .sound-on,
  .opening-sound[data-enabled="true"] .sound-off,
  .opening-pause[data-paused="false"] .play-icon,
  .opening-pause[data-paused="true"] .pause-icon { display: none; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .opening-control:hover { transform: translateY(-2px) scale(1.08); }
  }
  @media (prefers-reduced-motion: reduce) {
    .opening-control { transition: none; }
  }
  [hidden] { display: none !important; }
  .opening-status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
</style>
