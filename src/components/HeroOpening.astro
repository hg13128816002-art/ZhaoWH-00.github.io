---
import entrySource from '../scripts/opening/entry.js?raw';
import '../styles/hero-opening.css';
---
<script is:inline set:html={`(() => {
${entrySource.replace(/^export /gm, '')}
document.documentElement.dataset.openingEntry = claimOpeningEntry();
})();`} />
<div class="hero-opening" data-hero-opening-root data-state="loading"
  data-dark-src="/videos/opening-short-dark.mp4" data-light-src="/videos/opening-short-light.mp4"
  aria-label="Zhao Wenhao 开场动画">
  <video class="opening-video" data-opening-video muted playsinline preload="none"
    disablepictureinpicture disableremoteplayback aria-hidden="true" tabindex="-1"
    width="2560" height="1068"></video>
</div>
<noscript><style>.hero-opening { display:none !important; }</style></noscript>
