---
import { detailedIds } from '../data/catalog';
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><title>正在打开作品</title></head>
<body style="background:#040a10;color:#acdbfb"><a href="/works/">浏览全部作品</a>
<script is:inline define:vars={{ detailedIds }}>
let id = location.hash.slice(1);
if (id === 'synesthesia') id = 'synesthesia-canvas';
location.replace(detailedIds.includes(id) ? '/works/' + id + '/' : '/works/');
</script></body></html>
