    /* 悬停时配图掀开的起点由 --media-wipe 给出（见悬停预览样式块），
       缺变量时按「从下边往上掀」兜底 */
    @keyframes timelineMediaIn {
      from {
        clip-path: var(--media-wipe, inset(100% 0 0 0 round 13px));
        opacity: 0;
      }

      to {
        clip-path: inset(0 round 13px);
        opacity: 1;
      }
    }

    /* ---- 生长：卡片不是「点亮」，而是随着轴线扫过从轴上真正长出来 ----
       .is-active 的时机完全由生长头是否越过该节点决定（见脚本 setTimelineProgress），
       于是「轴线扫过 → 就地生长」是先后关系，而不是提前摆好再调透明度。
       未生长的节点在视觉上等于不存在（0 尺寸的索引锚点仍然待在原位）：
       引线沿自身方向由 0 长度撑开，卡片从贴着引线的那条边向外展开（裁剪 + 轻微拉伸 + 外移），
       刻度圆点从 0 缩放冒出来，年月像被写出来一样横向展开。
       这一整套只在桌面端生效；移动端是静态竖排列表，另有断点覆盖。 */
    @media (min-width: 901px) {
      /* 还没长出来的卡片不接收鼠标与点击，免得摸到看不见的东西 */
      .timeline-node {
        pointer-events: none;
      }

      .timeline-node:where(.is-active) {
        pointer-events: auto;
      }

      /* 两侧各自的生长方向与生根边：上排卡片从底边往上涨，下排从顶边往下长；
         被裁剪掉的一侧正好是贴着引线的那一侧，所以看起来是从引线末端长出来的 */
      .timeline-node[data-card-side="up"] {
        --growth-lift: 16px;
        --tick-lift: -0.3rem;
        --card-clip-hidden: inset(100% -64px -64px -64px round 14px);
      }

      .timeline-node[data-card-side="down"] {
        --growth-lift: -16px;
        --tick-lift: 0.3rem;
        --card-clip-hidden: inset(-64px -64px 100% -64px round 14px);
      }

      .timeline-node[data-card-side="up"] .timeline-node-body {
        transform-origin: 50% 100%;
      }

      .timeline-node[data-card-side="down"] .timeline-node-body {
        transform-origin: 50% 0%;
      }

      /* 未生长：引线零长度、卡片缩在轴线一侧、刻度日期还没写出来 */
      .timeline-leader {
        opacity: 1;
        transform: translateX(-50%) scaleY(0);
        transition: transform 460ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      .timeline-node[data-card-side="up"] .timeline-leader {
        transform-origin: 50% 100%;
      }

      .timeline-node[data-card-side="down"] .timeline-leader {
        transform-origin: 50% 0%;
      }

      /* 裁剪范围比卡片本身大 64px，生长完成后四周的投影与当前态描边才不会被一起裁掉 */
      .timeline-node-body {
        clip-path: var(--card-clip-hidden, inset(100% -64px -64px -64px round 14px));
        opacity: 0;
        transform: translate(-50%, var(--growth-lift, 16px)) scaleY(0.88);
        transition:
          clip-path 520ms cubic-bezier(0.22, 1, 0.36, 1) 90ms,
          opacity 200ms linear 60ms,
          transform 560ms cubic-bezier(0.22, 1, 0.36, 1) 90ms,
          border-color 200ms ease,
          box-shadow 200ms ease;
      }

      .timeline-tick i {
        transform: translate(-50%, -50%) scale(0);
      }

      .timeline-tick b,
      .timeline-tick small {
        clip-path: inset(0 100% 0 0);
        opacity: 0;
        transform: translate(-50%, var(--tick-lift, 0px));
        transition:
          color 200ms ease,
          clip-path 420ms cubic-bezier(0.22, 1, 0.36, 1) 80ms,
          opacity 160ms linear 120ms,
          transform 420ms cubic-bezier(0.22, 1, 0.36, 1) 80ms;
      }

      /* 已生长：引线撑满、卡片展开归位、圆点弹出、日期写完。
         圆点的缩放要留出位置给 .is-current 的 1.45 倍放大态，
         所以这一组用 :where() 把权重压到低于 .is-current，只压得住未生长态。 */
      .timeline-node:where(.is-active) .timeline-leader {
        transform: translateX(-50%) scaleY(1);
      }

      .timeline-node:where(.is-active) .timeline-node-body {
        clip-path: inset(-64px round 14px);
        opacity: 1;
        transform: translate(-50%, 0) scaleY(1);
      }

      .timeline-node:where(.is-active) .timeline-tick i {
        transform: translate(-50%, -50%) scale(1);
      }

      .timeline-node:where(.is-active) .timeline-tick b,
      .timeline-node:where(.is-active) .timeline-tick small {
        clip-path: inset(0 0 0 0);
        opacity: 1;
        transform: translate(-50%, 0);
      }
    }

    /* ---- 悬停预览：把卡片里的配图铺到卡片上 ----
       卡片很窄，配图在桌面端一直是 display:none（见上方基础规则），于是平时不占排版位置、
       也不由时间轴自己发起下载（display:none 没有盒子，loading="lazy" 不触发；实测过
       只属于时间轴的封面始终是 0x0，只有和下方 WORKS 区块共用的那几张会跟着那边一起进来）。
       悬停时它才铺满整张卡片：绝对定位、退出排版，脚本量到的卡片高度与轴线几何完全不变；
       掀开的起点和卡片本身的生长方向一致——上排从贴着引线的底边往上，下排从顶边往下。
       日期与标题抬到图上方的暗底上照旧可读，说明文字先让位给图。
       整套只在能真正悬停的桌面端生效，移动端（≤900px）的静态大图不受影响。 */
    @media (min-width: 901px) and (hover: hover) {
      /* 掀开的起点：默认给上排（从底边往上），下排覆盖成从顶边往下 */
      .timeline-node.has-media .timeline-node-body {
        --media-wipe: inset(100% 0 0 0 round 13px);
      }

      .timeline-node.has-media[data-card-side="down"] .timeline-node-body {
        --media-wipe: inset(0 0 100% 0 round 13px);
      }

      /* 悬停：单图与双图共用同一套定位（margin 也清零，免得绝对定位被外边距推偏） */
      .timeline-node.has-media .timeline-node-body:hover > .timeline-node-media,
      .timeline-node.has-media .timeline-node-body:hover > .timeline-media-pair {
        animation: timelineMediaIn 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
        clip-path: inset(0 round 13px);
        inset: 0;
        margin: 0;
        opacity: 1;
        position: absolute;
      }

      .timeline-node.has-media .timeline-node-body:hover > .timeline-node-media {
        display: block;
      }

      /* 双图：左右各占一格铺满 */
      .timeline-node.has-media .timeline-node-body:hover > .timeline-media-pair {
        display: grid;
        gap: 3px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      /* 图铺开时去掉小方块的方比、描边与褪色滤镜，直接给真实画面 */
      .timeline-node.has-media .timeline-node-body:hover .timeline-node-media {
        aspect-ratio: auto;
        border: 0;
        border-radius: 13px;
        filter: none;
        height: 100%;
        object-fit: cover;
        width: 100%;
      }

      /* 图上的暗底：只压上半张，日期与标题照旧压得住 */
      .timeline-node.has-media .timeline-node-body::after {
        background: linear-gradient(180deg, rgba(4, 10, 16, 0.9) 0%, rgba(4, 10, 16, 0.72) 32%, rgba(4, 10, 16, 0.22) 66%, rgba(4, 10, 16, 0) 100%);
        border-radius: 13px;
        content: "";
        inset: 0;
        opacity: 0;
        pointer-events: none;
        position: absolute;
        transition: opacity 240ms ease;
        z-index: 2;
      }

      .timeline-node.has-media .timeline-node-body:hover::after {
        opacity: 1;
      }

      /* 文字抬到图与暗底之上；说明文字让位 */
      .timeline-node.has-media .timeline-node-body > .timeline-node-meta,
      .timeline-node.has-media .timeline-node-body > strong,
      .timeline-node.has-media .timeline-node-body > em {
        position: relative;
        transition: opacity 240ms ease;
        z-index: 3;
      }

      .timeline-node.has-media .timeline-node-body:hover > em {
        opacity: 0;
      }

      .timeline-node.has-media .timeline-node-body:hover > .timeline-node-meta,
      .timeline-node.has-media .timeline-node-body:hover > strong {
        text-shadow: 0 1px 14px rgba(4, 10, 16, 0.8);
      }
    }

    /* 窄桌面：12 张卡片同屏时单张列宽有限，先收起说明，保住标题完整可读 */
    @media (min-width: 901px) and (max-width: 1319px) {
      .timeline-node-body em {
        display: none;
      }
    }

    /* 浅色主题：全局规则会把卡片文字压成深色，卡片必须换成白底才不会深底深字 */
    @media (min-width: 901px) {
      html[data-theme="light"] .timeline-node-body {
        background: rgba(255, 255, 255, 0.94);
        border-color: rgba(4, 10, 16, 0.14);
        box-shadow: 0 18px 44px rgba(16, 22, 28, 0.12);
      }

      html[data-theme="light"] .timeline-node-body .timeline-node-meta {
        color: #2E6A96;
      }

      html[data-theme="light"] .timeline-node.is-current .timeline-node-body {
        border-color: rgba(4, 10, 16, 0.44);
        box-shadow:
          0 22px 52px rgba(16, 22, 28, 0.18),
          0 0 0 1px rgba(4, 10, 16, 0.1);
      }

      html[data-theme="light"] .timeline-leader {
        background: linear-gradient(180deg, rgba(4, 10, 16, 0.44), rgba(4, 10, 16, 0.08));
      }

      html[data-theme="light"] .timeline-node[data-card-side="down"] .timeline-leader {
        background: linear-gradient(0deg, rgba(4, 10, 16, 0.44), rgba(4, 10, 16, 0.08));
      }

      html[data-theme="light"] .timeline-leader::after {
        background: rgba(4, 10, 16, 0.5);
      }

      /* 刻度文字在浅色底上要压深，浅蓝在白色上几乎看不见 */
      html[data-theme="light"] .timeline-tick b {
        color: rgba(4, 10, 16, 0.68);
      }

      html[data-theme="light"] .timeline-tick small {
        color: rgba(4, 10, 16, 0.46);
      }

      html[data-theme="light"] .timeline-node.is-active .timeline-tick b {
        color: rgba(4, 10, 16, 0.82);
      }

      html[data-theme="light"] .timeline-node.is-active .timeline-tick small {
        color: #2E6A96;
      }

      html[data-theme="light"] .timeline-node.is-active .timeline-tick i {
        background: #2E6A96;
        border-color: #2E6A96;
        box-shadow: 0 0 14px rgba(46, 106, 150, 0.42);
      }

      /* 浅色主题的卡片是白底深字，悬停把图铺上来之后文字得反过来压成亮的
         （全局规则用 !important 把卡片文字压成深色，这里必须同样 !important 才盖得住） */
      html[data-theme="light"] .timeline-node.has-media .timeline-node-body:hover > .timeline-node-meta {
        color: #ACDBFB !important;
      }

      html[data-theme="light"] .timeline-node.has-media .timeline-node-body:hover > strong {
        color: #ffffff !important;
      }
    }

