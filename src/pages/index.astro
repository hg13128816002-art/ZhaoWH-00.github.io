---
// src/pages/index.astro
// 首页：英雄区粒子宇宙 + 创作编年时间轴 + Works 作品叠层 + Profile 3D 模型
import Layout from '../layouts/Layout.astro';
import Preloader from '../components/Preloader.astro';
import { timelineNodes } from '../data/timeline';
import { workCategories, works } from '../data/works';
---

<style>
  :root {
    --stable-app-height: 100vh;
  }
  
  .font-mono {
    font-family: var(--font-mono-cn) !important;
  }

  #home-hero {
    contain: paint;
  }

  .hero-title-stack {
    font-family: var(--font-sans-cn);
    transform: translateY(clamp(-2.9rem, -5.2vh, -1.7rem));
  }

  .hero-dot {
    animation: heroDotBlink 1.05s steps(2, start) infinite;
    display: inline-block;
  }

  @keyframes heroDotBlink {
    0%, 48% {
      opacity: 1;
    }

    49%, 100% {
      opacity: 0;
    }
  }
</style>

<Layout
  title="ZHAO WENHAO // PORTFOLIO"
  bodyClass="w-full min-h-screen bg-[#040A10] overflow-x-hidden select-none relative"
  bodyStyle="margin: 0; padding: 0; background-color: #040A10;"
>
  <script type="importmap" is:inline slot="head">
    {
      "imports": {
        "three": "https://unpkg.com/three@0.165.0/build/three.module.js",
        "three/addons/": "https://unpkg.com/three@0.165.0/examples/jsm/"
      }
    }
  </script>

  <Preloader />

  <section id="home-hero" class="relative w-full h-screen overflow-hidden">
  <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden flex flex-col justify-center opacity-25">
    <div class="w-[280vw] -translate-x-[80vw] rotate-[-24deg] flex flex-col gap-2 select-none">
      <div class="marquee-left text-[#252B31] font-black text-6xl md:text-8xl tracking-tighter whitespace-nowrap">
        ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO //
      </div>
      <div class="marquee-right text-[#252B31] font-black text-6xl md:text-8xl tracking-tighter whitespace-nowrap">
        ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO //
      </div>
      <div class="marquee-left text-[#252B31] font-black text-6xl md:text-8xl tracking-tighter whitespace-nowrap">
        ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO //
      </div>
      <div class="marquee-right text-[#252B31] font-black text-6xl md:text-8xl tracking-tighter whitespace-nowrap">
        ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO //
      </div>
      <div class="marquee-left text-[#252B31] font-black text-6xl md:text-8xl tracking-tighter whitespace-nowrap">
        ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO //
      </div>
      <div class="marquee-right text-[#252B31] font-black text-6xl md:text-8xl tracking-tighter whitespace-nowrap">
        ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO //
      </div>
      <div class="marquee-left text-[#252B31] font-black text-6xl md:text-8xl tracking-tighter whitespace-nowrap">
        ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO //
      </div>
      <div class="marquee-right text-[#252B31] font-black text-6xl md:text-8xl tracking-tighter whitespace-nowrap">
        ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO //
      </div>
      <div class="marquee-left text-[#252B31] font-black text-6xl md:text-8xl tracking-tighter whitespace-nowrap">
        ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO // ZHAOWENHAO //
      </div>
    </div>
  </div>

  <canvas id="omni-universe" class="absolute inset-0 block w-full h-full z-10 pointer-events-none"></canvas>

  <div class="absolute inset-0 z-20 pointer-events-none flex flex-col items-center justify-center">
    <div class="hero-title-stack flex flex-col items-center justify-center gap-2 select-none">
      <h1 class="font-bold text-6xl md:text-[9.5rem] tracking-tight leading-none text-[#ACDBFB] drop-shadow-[0_0_35px_rgba(172,219,251,0.4)]" style="color: #ACDBFB;">MAKE</h1>
      <h1 class="font-bold text-6xl md:text-[9.5rem] tracking-tight leading-none text-[#ACDBFB] drop-shadow-[0_0_35px_rgba(172,219,251,0.4)]" style="color: #ACDBFB;">SOMETHING</h1>
      <h1 class="font-bold text-6xl md:text-[9.5rem] tracking-tight leading-none text-[#ACDBFB] drop-shadow-[0_0_35px_rgba(172,219,251,0.4)]" style="color: #ACDBFB;">DIFFERENT<span class="hero-dot">.</span></h1>
    </div>

      <div class="absolute bottom-8 inset-x-0 z-20 px-5 text-center pointer-events-none md:bottom-10">
      <span class="block whitespace-nowrap text-neutral-600 text-[clamp(0.72rem,3.1vw,1.125rem)] md:text-2xl tracking-[0.16em] md:tracking-[0.4em] animate-pulse font-mono">
        [ ⬇ 向下滑动 探索更多 ⬇ ]
      </span>
    </div>
  </div>

  <div id="warp-flash" class="absolute inset-0 bg-[#ACDBFB] z-50 opacity-0 pointer-events-none transition-opacity duration-300"></div>
  </section>

  <main class="home-sections">
    <section class="home-section chronology-section" aria-labelledby="creative-chronology-title">
      <div class="chronology-pin">
        <div class="chronology-copy">
          <div class="chronology-heading">
            <div class="section-kicker">01 / CREATIVE CHRONOLOGY</div>
            <div class="section-head">
              <h2 id="creative-chronology-title">TIMELINE</h2>
            </div>
          </div>
          <div class="chronology-progress">
            <span data-timeline-current>00</span>
            <i></i>
            <span>12</span>
          </div>
        </div>

        <div class="chronology-map" aria-label="创作编年时间轴">
          <div class="chronology-world" data-timeline-world>
            <svg class="chronology-svg" viewBox="0 0 1200 420" preserveAspectRatio="none" aria-hidden="true">
              <defs>
                <clipPath id="timeline-live-clip" clipPathUnits="userSpaceOnUse">
                  <rect data-timeline-live-clip x="-40" y="-40" width="0" height="520" />
                </clipPath>
              </defs>
              <path class="chronology-path is-ghost" d="M -40 300 L 1240 300" />
              <path
                class="chronology-path is-live"
                data-timeline-path
                clip-path="url(#timeline-live-clip)"
                d="M -40 300 L 1240 300"
              />
            </svg>
            <span class="timeline-head" data-timeline-head aria-hidden="true"></span>

            {timelineNodes.map((node, index) => {
              const [datePart = '', typePart = ''] = node.meta.split('/');
              const media = node.media ?? [];
              return (
                <a
                  class:list={['timeline-node', { 'has-media': media.length > 0 }]}
                  href={node.href}
                  data-timeline-node
                  data-node-index={index}
                  aria-label={`${node.meta.replace('/', '·')} — ${node.title}`}
                >
                  <span class="timeline-leader" aria-hidden="true"></span>
                  <span class="timeline-tick" aria-hidden="true">
                    <i></i>
                    <b>{datePart.trim()}</b>
                    <small>{typePart.trim()}</small>
                  </span>
                  <span class="timeline-node-body">
                    <span class="timeline-node-meta">{node.meta}</span>
                    <strong>{node.title}</strong>
                    <em>{node.note}</em>
                    {media.length === 1 && (
                      <img
                        class="timeline-node-media"
                        src={media[0].src}
                        alt={media[0].alt}
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                    {media.length > 1 && (
                      <span class="timeline-media-pair">
                        {media.map((item) => (
                          <img
                            class="timeline-node-media"
                            src={item.src}
                            alt={item.alt}
                            loading="lazy"
                            decoding="async"
                          />
                        ))}
                      </span>
                    )}
                  </span>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </section>

    <section class="home-section works-section" aria-labelledby="home-works-title">
      <div class="works-pin">
        <div class="works-control">
          <h2 id="home-works-title"><span aria-hidden="true"></span>WORKS CATEGORY</h2>
          <div class="works-category-list" aria-label="作品分类">
            {workCategories.map((category) => (
              <button
                class:list={['works-category', { 'is-active': category.id === works[0].category }]}
                type="button"
                data-work-category={category.id}
              >
                <span>{category.index}:</span> {category.label}
              </button>
            ))}
          </div>
          <div class="works-progress" aria-live="polite">
            <span data-work-current>01</span>
            <i></i>
            <span data-work-total>{String(works.length).padStart(2, '0')}</span>
          </div>
        </div>

        <div class="works-stage" aria-label="首页作品预览叠层">
          {works.map((item, index) => (
            <article
              class:list={['works-layer', { 'is-active': index === 0, 'is-video': item.kind === 'video' }]}
              data-work-card
              data-work-category={item.category}
              data-work-kind={item.kind}
            >
              <img
                src={item.image}
                alt={item.imageAlt}
                loading={item.eager ? 'eager' : 'lazy'}
                decoding="async"
              />
              {item.video && <video src={item.video} preload="none" muted playsinline></video>}
              {item.kind === 'video' && (
                <button class="works-play" type="button" aria-label={item.playLabel}>CLICK TO PLAY</button>
              )}
              <div class="works-layer-copy">
                <span>{item.era}</span>
                {item.titleEn ? (
                  <h3 class="works-title-split">
                    <span class="works-title-cn">{item.title}</span>
                    <span class="works-title-en">{item.titleEn}</span>
                  </h3>
                ) : (
                  <h3>{item.title}</h3>
                )}
                <p>{item.description}</p>
                <a
                  href={item.href}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                  aria-label={item.linkLabel}
                >{item.linkText}</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="home-section profile-section" aria-labelledby="home-profile-title">
      <div class="profile-layout">
        <div class="profile-copy">
          <div class="profile-copy-main">
            <div class="section-kicker">03 / PROFILE</div>
            <div class="profile-heading">
              <h2 id="home-profile-title">PROFILE</h2>
            </div>
            <p class="profile-lead">我是赵文浩，北京师范大学珠海校区未来设计学院 25 级本科生。</p>
            <p>我关注实验艺术、人机交互和游戏化叙事，习惯从议题研究出发，把想法转化为可被观看、操作和进入的作品。</p>
            <div class="profile-brief-list">
              <span>实验艺术</span>
              <span>人机交互</span>
              <span>游戏设计</span>
            </div>
            <div class="profile-detail-grid">
              <div>
                <span>METHOD</span>
                <p>议题研究 / 原型实验 / 体验叙事</p>
              </div>
              <div>
                <span>TOOLS</span>
                <p>Unity / Web / 影像 / 装置</p>
              </div>
            </div>
          </div>
          <div class="profile-mini">
            <div>
              <span>LEARNING</span>
              <strong>Unity / Vibe Coding</strong>
            </div>
            <div>
              <span>BASE</span>
              <strong>未来设计学院</strong>
            </div>
            <div>
              <span>MORE</span>
              <a class="profile-mini-link" href="/profile">VIEW PROFILE</a>
            </div>
          </div>
        </div>
        <div class="profile-visual">
          <div class="profile-model-panel" aria-label="Lunar lander 3D model">
            <canvas id="profile-model-canvas" aria-hidden="true"></canvas>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    // ================= 终极全域 Canvas 粒子引擎 =================
    const canvas = document.getElementById('omni-universe') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;

    let width = window.innerWidth;
    let height = window.innerHeight;
    const mobileMotionQuery = window.matchMedia('(max-width: 899px)');
    function resize() {
      width = window.innerWidth; height = window.innerHeight;
      canvas.width = width; canvas.height = height;
      if (mobileMotionQuery.matches) {
        ctx.clearRect(0, 0, width, height);
        canvas.style.visibility = 'hidden';
      }
    }
    window.addEventListener('resize', resize);
    resize();
    // 默认隐藏 canvas，待字体加载完毕再显示并开始渲染，避免回退字体被绘制到画布上
    canvas.style.visibility = 'hidden';

    let mouseX = width / 2;
    let mouseY = height / 2;
    let cursorX = mouseX;
    let cursorY = mouseY;

    if (window.matchMedia('(pointer: fine)').matches) {
      window.addEventListener('pointermove', (event) => {
        mouseX = event.clientX;
        mouseY = event.clientY;
      }, { passive: true });
    }

    // 信仰链目标定义 (尾部加入适量空格完美分布圆周)
    const creedString = "INTEGRATE THINKING INTO DESIGN • ";
    const targetLength = creedString.length;

    interface OmniParticle {
      x: number; y: number;
      baseX: number; baseY: number;
      originalChar: string;
      currentChar: string;
      size: number;
      angle: number; speed: number;
      clusterIndex: number;
      type: 'core' | 'ring';
      
      orbitR?: number;
      ringRX?: number; ringRY?: number; ringTilt?: number;
      
      // ！！！终极单层与指心控制属性 ！！！
      targetCursorSlot: number; // 预分配在信条环上的专属独立槽位 (0 - 32)
      isRingAssigned: boolean;  // 核心标记：该粒子是否被选中组成那绝对唯一的“单层光环”
      isCaptured: boolean;
    }

    const baseChars = ['设', '计', '思', '维', '先', '锋', '0', '1', '+', '#', '×', '•'];
    const particles: OmniParticle[] = [];
    const homeHero = document.getElementById('home-hero');
    let universeFrameId = 0;
    let isUniverseReady = false;
    let isUniverseVisible = true;
    
    // ！！！极其核心修复：精准映射手绘图的三体布局与大小节奏 ！！！
    const planets = [
      // 01. 红色区域：超巨型主星 (左上至中左)。极大画幅，拥有辽阔顺时针星环，长轴略微右偏。
      { cx: width * 0.28, cy: height * 0.45, coreR: 176, ringRX: 418, ringRY: 132, tilt: 0.35, orbitRotation: Math.PI / 12, dir: 1, pCore: 220, pRing: 260, baseSize: 16 },
      // 02. 黄色区域：中型伴星 (右下偏中)。适中画幅，逆时针偏转大星环，长轴左倾。
      { cx: width * 0.78, cy: height * 0.75, coreR: 90, ringRX: 240, ringRY: 75, tilt: -0.4, orbitRotation: -Math.PI / 6, dir: -1, pCore: 120, pRing: 150, baseSize: 13 },
      // 03. 蓝色区域：微型远星 (右上深空)。极其精致紧凑，点缀深空景深。
      { cx: width * 0.82, cy: height * 0.22, coreR: 50, ringRX: 140, ringRY: 40, tilt: 0.2, orbitRotation: Math.PI / 8, dir: 1, pCore: 70, pRing: 90, baseSize: 10 }
    ];

    // 全量安全天体灌注 (修复底层死锁)
    planets.forEach((p, pIdx) => {
      // 灌注自转内核
      for (let i = 0; i < p.pCore; i++) {
        // 确保每个星球平均只有前 targetLength 个粒子被标记为“单层组成者”，多余的仅作普通飞溅物
        const slot = i % targetLength;
        const isAssigned = i < targetLength; 
        particles.push({
          x: 0, y: 0, baseX: 0, baseY: 0,
          originalChar: baseChars[Math.floor(Math.random() * baseChars.length)],
          currentChar: '', size: Math.random() * 6 + p.baseSize,
          angle: Math.random() * Math.PI * 2, speed: (Math.random() * 0.004 + 0.002) * p.dir,
          clusterIndex: pIdx, type: 'core', orbitR: Math.sqrt(Math.random()) * p.coreR,
          targetCursorSlot: slot, isRingAssigned: isAssigned, isCaptured: false
        });
      }
      // 灌注宏大星环
      for (let i = 0; i < p.pRing; i++) {
        const slot = i % targetLength;
        // 让星环也贡献一层备用骨架，确保视觉极其丰满但绝不重叠乱码
        const isAssigned = i < targetLength; 
        particles.push({
          x: 0, y: 0, baseX: 0, baseY: 0,
          originalChar: baseChars[Math.floor(Math.random() * baseChars.length)],
          currentChar: '', size: Math.random() * 4 + p.baseSize * 0.8,
          angle: (i / p.pRing) * Math.PI * 2, speed: (0.0015 + Math.random() * 0.0015) * p.dir,
          clusterIndex: pIdx, type: 'ring', 
          ringRX: p.ringRX * (0.82 + Math.random() * 0.36), ringRY: p.ringRY * (0.82 + Math.random() * 0.36),
          ringTilt: p.tilt,
          targetCursorSlot: slot, isRingAssigned: isAssigned, isCaptured: false
        });
      }
    });

    let cursorSpinAngle = 0;

    function renderUniverse() {
      universeFrameId = 0;
      if (!isUniverseReady || !isUniverseVisible || document.hidden) return;

      if (mobileMotionQuery.matches) {
        ctx.clearRect(0, 0, width, height);
        canvas.style.visibility = 'hidden';
        return;
      }

      ctx.clearRect(0, 0, width, height);

      // 光标物理缓动更新
      cursorX += (mouseX - cursorX) * 0.15;
      cursorY += (mouseY - cursorY) * 0.15;
      
      // 光标环自转极速驱动
      cursorSpinAngle += 0.015;

      // 实时计算三体核心响应视口变化
      planets[0].cx = width * 0.28; planets[0].cy = height * 0.45;
      planets[1].cx = width * 0.78; planets[1].cy = height * 0.75;
      planets[2].cx = width * 0.82; planets[2].cy = height * 0.22;

      particles.forEach(n => {
        const p = planets[n.clusterIndex];

        // --- 独立天体矩阵轨道演算 ---
        n.angle += n.speed;
        let localX = 0; let localY = 0;

        if (n.type === 'core') {
          localX = Math.cos(n.angle) * n.orbitR!;
          localY = Math.sin(n.angle) * n.orbitR!;
        } else {
          const ux = Math.cos(n.angle) * n.ringRX!;
          const uy = Math.sin(n.angle) * n.ringRY!;
          localX = ux * Math.cos(n.ringTilt!) - uy * Math.sin(n.ringTilt!);
          localY = ux * Math.sin(n.ringTilt!) + uy * Math.cos(n.ringTilt!);
        }

        // 叠加天体偏转角形成彻底独立的朝向错落感
        n.baseX = p.cx + (localX * Math.cos(p.orbitRotation) - localY * Math.sin(p.orbitRotation));
        n.baseY = p.cy + (localX * Math.sin(p.orbitRotation) + localY * Math.cos(p.orbitRotation));

        // --- 物理场域干涉判定 ---
        const distToPlanet = Math.hypot(cursorX - p.cx, cursorY - p.cy);
        const domainRadius = n.clusterIndex === 0 ? 500 : (n.clusterIndex === 1 ? 320 : 250);

        if (distToPlanet < domainRadius) {
          const distToCursor = Math.hypot(cursorX - n.baseX, cursorY - n.baseY);
          const pullRange = 250; 

          if (distToCursor < pullRange) {
            n.isCaptured = true;
          }
        } else {
          n.isCaptured = false;
        }

        // --- ！！！极致显像输出：应用绝对单层与头顶指心矩阵 ！！！ ---
        ctx.save();
        
        if (n.isCaptured) {
          if (n.isRingAssigned) {
            // 【主干信条层】：被选中的粒子极其精准地嵌入基准位，形成绝对唯一单层光环
            const targetSlotAngle = cursorSpinAngle + (n.targetCursorSlot / targetLength) * Math.PI * 2;
            const targetRingX = cursorX + Math.cos(targetSlotAngle) * 125; // 轨道半径加大至 125px 确保绝佳间距
            const targetRingY = cursorY + Math.sin(targetSlotAngle) * 125;

            n.x += (targetRingX - n.x) * 0.18;
            n.y += (targetRingY - n.y) * 0.18;

            n.currentChar = creedString[n.targetCursorSlot];
            ctx.fillStyle = '#ACDBFB'; 
            ctx.font = 'bold 15px sans-serif'; 

            // ！！！完美几何秩序：头顶精确指心 ！！！
            // 将字符输出原点移至当前坐标，旋转角度锁定为目标夹角 + $\pi/2$ (90度)
            ctx.translate(n.x, n.y);
            ctx.rotate(targetSlotAngle + Math.PI / 2);
            ctx.fillText(n.currentChar, 0, 0); 
          } else {
            // 【外围飞溅游离层】：未被选入文字环的多余粒子，仅作为被吸引的光带飞散在中心周围
            // 绝不直接拼成乱序文字干扰圆环阅读，保证画面既有被掠夺的宏大动感又绝对干净！
            const pullAngle = Math.atan2(cursorY - n.baseY, cursorX - n.baseX);
            n.x += (cursorX - Math.cos(pullAngle) * 80 - n.x) * 0.1;
            n.y += (cursorY - Math.sin(pullAngle) * 80 - n.y) * 0.1;

            n.currentChar = n.originalChar;
            ctx.fillStyle = 'rgba(172, 219, 251, 0.4)'; 
            ctx.font = `bold ${n.size * 0.8}px monospace`;
            ctx.translate(n.x, n.y);
            ctx.fillText(n.currentChar, 0, 0); 
          }
        } else {
          // 【母星引力崩溃回吸态】：干净利落地自动吸回原始星系阵地
          n.x += (n.baseX - n.x) * 0.12;
          n.y += (n.baseY - n.y) * 0.12;
          
          n.currentChar = n.originalChar;
          ctx.fillStyle = n.type === 'ring' ? 'rgba(172, 219, 251, 0.25)' : 'rgba(120, 120, 120, 0.35)';
          ctx.font = `bold ${n.size}px monospace`;
          ctx.translate(n.x, n.y);
          ctx.fillText(n.currentChar, 0, 0); 
        }

        ctx.restore();
      });

      universeFrameId = requestAnimationFrame(renderUniverse);
    }

    function syncUniversePlayback() {
      const shouldRender = isUniverseReady && isUniverseVisible && !document.hidden && !mobileMotionQuery.matches;

      if (!shouldRender) {
        if (universeFrameId) {
          cancelAnimationFrame(universeFrameId);
          universeFrameId = 0;
        }

        if (mobileMotionQuery.matches) {
          canvas.style.visibility = 'hidden';
          ctx.clearRect(0, 0, width, height);
        }
        return;
      }

      canvas.style.visibility = 'visible';
      if (!universeFrameId) universeFrameId = requestAnimationFrame(renderUniverse);
    }

    function startUniverse() {
      isUniverseReady = true;
      syncUniversePlayback();
    }

    if (homeHero) {
      const heroVisibilityObserver = new IntersectionObserver(([entry]) => {
        isUniverseVisible = Boolean(entry?.isIntersecting);
        syncUniversePlayback();
      });
      heroVisibilityObserver.observe(homeHero);
    }

    document.addEventListener('visibilitychange', syncUniversePlayback);
    mobileMotionQuery.addEventListener('change', syncUniversePlayback);

    // 等待字体加载完毕再开始渲染
    if (window.fontsReadyPromise) {
      window.fontsReadyPromise.then(startUniverse);
    } else if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(startUniverse);
    } else {
      startUniverse();
    }

    const chronologySection = document.querySelector('.chronology-section') as HTMLElement | null;
    const timelineMap = document.querySelector('.chronology-map') as HTMLElement | null;
    const timelineWorld = document.querySelector('[data-timeline-world]') as HTMLElement | null;
    const timelineSvg = document.querySelector('.chronology-svg') as SVGSVGElement | null;
    const timelinePath = document.querySelector('[data-timeline-path]') as SVGPathElement | null;
    const timelineGhostPath = document.querySelector('.chronology-path.is-ghost') as SVGPathElement | null;
    const timelineLiveClip = document.querySelector('[data-timeline-live-clip]') as SVGRectElement | null;
    const timelineHead = document.querySelector('[data-timeline-head]') as HTMLElement | null;
    const timelineNodes = Array.from(document.querySelectorAll('[data-timeline-node]')) as HTMLElement[];
    const timelineCurrent = document.querySelector('[data-timeline-current]') as HTMLElement | null;
    const mobileHomeQuery = window.matchMedia('(max-width: 899px)');
    let timelineScrollRaf: number | undefined;
    let timelineSpringRaf: number | undefined;
    let timelineSpringTime = 0;
    let targetTimelineProgress = 0;
    let visualTimelineProgress = 0;
    let timelineVelocity = 0;
    /** 轴线相对区块顶边的距离，用于把生长进度锚定到「轴线进入视口」的那一刻 */
    let timelineContentOffset = 0;
    /** 悬停/聚焦的节点索引；-1 表示回到「最后一个已生长节点」 */
    let hoveredTimelineIndex = -1;
    let stableMobileViewportWidth = window.innerWidth;
    let stableMobileViewportHeight = window.innerHeight;

    function getInteractionViewportHeight() {
      return window.innerWidth < 900 ? stableMobileViewportHeight : window.innerHeight;
    }

    function isMobileHomeFallback() {
      return mobileHomeQuery.matches;
    }

    function applyStableViewportMetrics() {
      const viewportHeight = getInteractionViewportHeight();
      document.documentElement.style.setProperty('--stable-app-height', `${viewportHeight}px`);

      chronologySection?.style.removeProperty('--timeline-section-height');
      chronologySection?.style.removeProperty('min-height');
    }

    function refreshStableViewportSize(force = false) {
      const widthDelta = Math.abs(window.innerWidth - stableMobileViewportWidth);
      const shouldRefresh = force || window.innerWidth >= 900 || widthDelta > 8;
      if (!shouldRefresh) return;

      stableMobileViewportWidth = window.innerWidth;
      stableMobileViewportHeight = window.innerHeight;
      applyStableViewportMetrics();
    }

    applyStableViewportMetrics();

    function isNearInteractiveSection(section: HTMLElement, lead = 1.15, tail = 0.45) {
      const viewportHeight = getInteractionViewportHeight();
      const sectionTop = section.offsetTop;
      const sectionBottom = sectionTop + section.offsetHeight;
      return window.scrollY >= sectionTop - viewportHeight * lead && window.scrollY <= sectionBottom + viewportHeight * tail;
    }

    function stopTimelineMotion() {
      if (timelineSpringRaf) {
        window.cancelAnimationFrame(timelineSpringRaf);
        timelineSpringRaf = undefined;
      }
      timelineVelocity = 0;
    }

    /**
     * 横向时间轴的几何：12 个节点在容器里等距铺开，纵向走一条明显的正弦折线。
     * 每个节点都带一条引线牵回轴上的刻度；卡片分上下两排交错站位，
     * 并跟着折线做半幅起伏，于是同屏 12 张既挤不到一起，也不会盖住轴线。
     * 卡片本身不预先摆好，而是等生长头扫到该节点时才从引线末端长出来（见样式里的生长块）。
     * 坐标全部取容器实测像素，SVG 路径与 HTML 刻度天然处在同一坐标空间。
     */
    function setupTimelineGeometry() {
      if (!timelinePath || !timelineMap || !timelineWorld || !timelineNodes.length) return;

      const mapRect = timelineMap.getBoundingClientRect();
      const width = Math.max(320, Math.round(mapRect.width));
      const height = Math.max(240, Math.round(mapRect.height));
      const lastIndex = Math.max(1, timelineNodes.length - 1);

      // 卡片宽度 = 同一排里相邻卡片的中心距 - 间距；两端各留半张卡，首尾卡片正好贴住容器内边
      const cardGap = Math.round(Math.min(26, Math.max(14, width * 0.016)));
      const edgeInset = 6;
      const pitch = Math.max(46, (width + cardGap - edgeInset * 2) / (lastIndex + 2));
      const cardWidth = Math.max(96, Math.round(pitch * 2 - cardGap));
      const padX = Math.round(cardWidth / 2 + edgeInset);
      const span = Math.round(pitch * lastIndex);
      const axisY = Math.round(height * 0.5);

      timelineWorld.style.width = `${width}px`;
      timelineWorld.style.height = `${height}px`;
      // 先写入卡片宽度，下面量到的高度才是真实排版下的高度
      timelineWorld.style.setProperty('--timeline-card-width', `${cardWidth}px`);

      // 记录轴线在区块内的纵向位置，生长进度以「轴线刚进入视口底部」为 0
      const sectionRect = chronologySection?.getBoundingClientRect();
      if (sectionRect) {
        timelineContentOffset = mapRect.top - sectionRect.top + axisY;
      }

      timelineSvg?.setAttribute('viewBox', `0 0 ${width} ${height}`);
      timelineLiveClip?.setAttribute('y', '-20');
      timelineLiveClip?.setAttribute('height', String(height + 40));

      // 卡片实测高度决定上下两排够不够放；不够就把起伏幅度与排间距等比收回来
      const cardHeight = timelineNodes.reduce(
        (max, node) =>
          Math.max(max, node.querySelector<HTMLElement>('.timeline-node-body')?.offsetHeight ?? 0),
        0
      );
      // 起伏幅度取容器高度的固定比例：小窗收紧、大屏放开，上限 5.5rem 免得夸张
      const maxAmplitude = Math.max(16, Math.min(88, height * 0.105));
      const baseGapUp = Math.max(18, Math.min(34, height * 0.065));
      const baseGapDown = Math.max(22, Math.min(44, height * 0.085));
      let amplitude = maxAmplitude;
      let gapUp = baseGapUp;
      let gapDown = baseGapDown;

      if (cardHeight > 0) {
        // 该侧所需高度 = 最高一张卡片底边离轴线的距离（1.5 × 幅度 + 间距）+ 卡片高度；
        // 超出就按比例把幅度与间距一起收回来，收到「刚好放得下」为止
        const fitScale = (room: number, gap: number) =>
          Math.min(1, Math.max(0.3, (room - cardHeight) / Math.max(1, maxAmplitude * 1.5 + gap)));
        const scale = Math.min(fitScale(axisY - 10, baseGapUp), fitScale(height - axisY - 10, baseGapDown));
        if (scale < 1) {
          amplitude = Math.max(12, maxAmplitude * scale);
          gapUp = Math.max(10, baseGapUp * scale);
          gapDown = Math.max(10, baseGapDown * scale);
        }
      }

      // 约 1.4 个周期的正弦，起伏一眼可见；首尾各多取一个点，让波形在容器外自然延伸
      const waveY = (index: number) => axisY + Math.sin(index * 0.78) * amplitude;

      const points = timelineNodes.map((node, index) => ({
        node,
        x: padX + (index / lastIndex) * span,
        y: waveY(index)
      }));

      const start = { x: Math.max(0, padX - pitch), y: waveY(-1) };
      const end = { x: Math.min(width, padX + span + pitch), y: waveY(lastIndex + 1) };
      const pathPoints = [start, ...points, end];
      const pathD = `M ${start.x} ${start.y} ${points
        .map((point) => `L ${point.x} ${point.y}`)
        .join(' ')} L ${end.x} ${end.y}`;
      timelinePath.setAttribute('d', pathD);
      timelineGhostPath?.setAttribute('d', pathD);

      const segmentLengths = pathPoints.slice(1).map((point, index) => {
        const previous = pathPoints[index];
        return Math.hypot(point.x - previous.x, point.y - previous.y);
      });
      const totalLength = segmentLengths.reduce((sum, length) => sum + length, 0) || 1;
      let accumulated = 0;

      // 路径由左至右单调推进，数组索引与 timelineNodes 一一对应，无需再排序过滤
      points.forEach((point, index) => {
        accumulated += segmentLengths[index];
        // 偶数节点卡片在上、奇数在下；卡片跟着折线做半幅起伏，引线于是有长有短
        const follow = (point.y - axisY) * 0.5;
        const side = index % 2 === 0 ? 'up' : 'down';
        const cardEdge =
          side === 'up' ? axisY - amplitude - gapUp + follow : axisY + amplitude + gapDown + follow;

        point.node.dataset.threshold = String(accumulated / totalLength);
        point.node.dataset.cardSide = side;
        point.node.style.setProperty('--node-x', `${point.x}px`);
        point.node.style.setProperty('--node-y', `${point.y}px`);
        point.node.style.setProperty(
          '--leader-length',
          `${Math.round(Math.max(14, Math.abs(cardEdge - point.y)))}px`
        );
      });
    }

    /**
     * 生长进度：轴线刚进入视口底部记 0，
     * 区块中心与视口中心重合记 1 —— 访客把这一屏滚到页面正中时，时间轴刚好长完。
     * 以轴线（而不是区块顶边）为锚点，生长过程才全程可见。
     */
    function getTimelineRevealProgress() {
      if (!chronologySection) return 0;
      const rect = chronologySection.getBoundingClientRect();
      const viewportHeight = getInteractionViewportHeight();
      const startTop = viewportHeight - timelineContentOffset;
      const endTop = (viewportHeight - rect.height) / 2;
      const travel = Math.max(1, startTop - endTop);
      return Math.min(Math.max((startTop - rect.top) / travel, 0), 1);
    }

    /** 移动端把 .chronology-world 还原成网格流，需要清掉脚本写入的像素尺寸 */
    function releaseTimelineWorldSize() {
      timelineWorld?.style.removeProperty('width');
      timelineWorld?.style.removeProperty('height');
    }


    function setTimelineTarget(progress: number, immediate = false) {
      targetTimelineProgress = Math.min(Math.max(progress, 0), 1);

      if (immediate) {
        if (timelineSpringRaf) {
          window.cancelAnimationFrame(timelineSpringRaf);
          timelineSpringRaf = undefined;
        }
        visualTimelineProgress = targetTimelineProgress;
        timelineVelocity = 0;
        setTimelineProgress(visualTimelineProgress);
        return;
      }

      if (Math.abs(targetTimelineProgress - visualTimelineProgress) < 0.0002 && Math.abs(timelineVelocity) < 0.0002) {
        return;
      }

      if (!timelineSpringRaf) {
        timelineSpringTime = performance.now();
        timelineSpringRaf = window.requestAnimationFrame(updateTimelineSpring);
      }
    }

    function updateTimelineSpring(timestamp: number) {
      const deltaTime = Math.min(0.032, Math.max(0.001, (timestamp - timelineSpringTime) / 1000));
      timelineSpringTime = timestamp;

      const displacement = targetTimelineProgress - visualTimelineProgress;
      const tension = 190;
      const damping = 15.5;

      timelineVelocity += displacement * tension * deltaTime;
      timelineVelocity *= Math.exp(-damping * deltaTime);
      visualTimelineProgress += timelineVelocity * deltaTime;

      if (Math.abs(displacement) < 0.00035 && Math.abs(timelineVelocity) < 0.00045) {
        visualTimelineProgress = targetTimelineProgress;
        timelineVelocity = 0;
        setTimelineProgress(visualTimelineProgress);
        timelineSpringRaf = undefined;
        return;
      }

      setTimelineProgress(visualTimelineProgress);
      timelineSpringRaf = window.requestAnimationFrame(updateTimelineSpring);
    }

    function setTimelineProgress(progress: number) {
      if (!chronologySection) return;
      const clamped = Math.min(Math.max(progress, 0), 1);
      chronologySection.style.setProperty('--timeline-progress', String(clamped));
      syncTimelineReveal(clamped);

      let revealedCount = 0;
      let lastRevealedIndex = -1;
      timelineNodes.forEach((node, index) => {
        const threshold = Number(node.dataset.threshold || 0);
        const isRevealed = clamped + 0.002 >= threshold;
        node.classList.toggle('is-active', isRevealed);
        if (isRevealed) {
          revealedCount += 1;
          lastRevealedIndex = index;
        }
      });

      // 详情卡：优先跟随悬停/聚焦的刻度（且只允许已经长出来的），否则停在最后一个已生长节点
      const focusedIndex =
        hoveredTimelineIndex >= 0 && hoveredTimelineIndex <= lastRevealedIndex
          ? hoveredTimelineIndex
          : lastRevealedIndex;
      timelineNodes.forEach((node, index) => {
        node.classList.toggle('is-current', index === focusedIndex);
      });

      if (timelineCurrent) timelineCurrent.textContent = String(revealedCount).padStart(2, '0');
    }

    /** 生长头与揭示裁剪都只沿横轴推进 */
    function syncTimelineReveal(progress: number) {
      if (!timelinePath) return;
      const pathLength = timelinePath.getTotalLength();
      if (!pathLength) return;
      const headPoint = timelinePath.getPointAtLength(pathLength * progress);

      if (timelineHead) {
        timelineHead.style.left = `${headPoint.x}px`;
        timelineHead.style.top = `${headPoint.y}px`;
      }

      // 裁剪矩形与线头同处一个 SVG 坐标系，高分屏缩放下边缘也能精确对齐
      timelineLiveClip?.setAttribute('width', String(Math.max(0, headPoint.x + 2)));
    }

    function syncTimelineToScroll() {
      setTimelineTarget(getTimelineRevealProgress());
    }

    function requestTimelineScrollSync() {
      if (chronologySection && !isNearInteractiveSection(chronologySection)) return;
      if (timelineScrollRaf) return;
      timelineScrollRaf = window.requestAnimationFrame(() => {
        timelineScrollRaf = undefined;
        syncTimelineToScroll();
      });
    }

    /** 悬停/聚焦刻度即切换详情卡；点击仍然是原链接跳转，不改变无障碍语义 */
    function bindTimelineNodeFocus() {
      timelineNodes.forEach((node, index) => {
        const apply = (value: number) => () => {
          if (hoveredTimelineIndex === value) return;
          hoveredTimelineIndex = value;
          setTimelineProgress(visualTimelineProgress);
        };
        node.addEventListener('mouseenter', apply(index));
        node.addEventListener('mouseleave', apply(-1));
        node.addEventListener('focus', apply(index));
        node.addEventListener('blur', apply(-1));
      });
    }

    const worksSection = document.querySelector('.works-section') as HTMLElement | null;
    const worksPin = document.querySelector('.works-pin') as HTMLElement | null;
    const worksStage = document.querySelector('.works-stage') as HTMLElement | null;
    const worksCards = Array.from(document.querySelectorAll('[data-work-card]')) as HTMLElement[];
    const worksCategories = Array.from(document.querySelectorAll('[data-work-category].works-category')) as HTMLButtonElement[];
    const worksCurrent = document.querySelector('[data-work-current]') as HTMLElement | null;
    const worksTotal = document.querySelector('[data-work-total]') as HTMLElement | null;
    let activeWorkIndex = 0;
    let visualWorkProgress = 0;
    let targetWorkProgress = 0;
    let worksScrollRaf: number | undefined;
    const pendingWorksVideoReveals = new WeakMap<HTMLVideoElement, EventListener>();

    function isMobileWorksLayout() {
      return isMobileHomeFallback();
    }

    function getWorksIntroHoldDistance() {
      return getInteractionViewportHeight() * (isMobileWorksLayout() ? 0.58 : 1.25);
    }

    function applyWorksViewportMetrics() {
      if (!worksSection) return;

      if (isMobileWorksLayout()) {
        worksSection.style.removeProperty('--works-intro-hold');
        worksSection.style.removeProperty('--works-step-scroll');
        worksSection.style.removeProperty('min-height');
      } else {
        worksSection.style.removeProperty('--works-intro-hold');
        worksSection.style.removeProperty('--works-step-scroll');
        worksSection.style.removeProperty('min-height');
      }
    }

    function restoreWorksVideoPoster(card: HTMLElement, video: HTMLVideoElement) {
      const pendingReveal = pendingWorksVideoReveals.get(video);
      if (pendingReveal) {
        video.removeEventListener('playing', pendingReveal);
        pendingWorksVideoReveals.delete(video);
      }
      const image = card.querySelector('img') as HTMLImageElement | null;
      delete card.dataset.videoLoading;
      video.style.removeProperty('opacity');
      image?.style.removeProperty('opacity');
      card.classList.remove('is-playing');
    }

    function stopWorksVideos(except?: HTMLElement) {
      worksCards.forEach((card) => {
        if (card === except) return;
        const video = card.querySelector('video') as HTMLVideoElement | null;
        if (!video) return;
        video.pause();
        restoreWorksVideoPoster(card, video);
      });
    }

    function syncWorksMeta() {
      if (!worksCards.length) return;
      const activeCard = worksCards[activeWorkIndex];
      const activeCategory = activeCard?.dataset.workCategory;

      worksCategories.forEach((button) => {
        button.classList.toggle('is-active', button.dataset.workCategory === activeCategory);
      });

      if (worksCurrent) worksCurrent.textContent = String(activeWorkIndex + 1).padStart(2, '0');
      if (worksTotal) worksTotal.textContent = String(worksCards.length).padStart(2, '0');
      if (isMobileWorksLayout()) {
        const overallProgress = worksCards.length > 1 ? activeWorkIndex / (worksCards.length - 1) : 1;
        worksSection?.style.setProperty('--work-step-progress', String(overallProgress));
      }
    }

    function renderWorksStack(progress = activeWorkIndex) {
      if (!worksCards.length) return;

      worksCards.forEach((card, index) => {
        const offset = index - activeWorkIndex;
        const absOffset = Math.abs(offset);
        const depth = Math.min(absOffset, 5);
        const isActive = index === activeWorkIndex;
        const isPast = offset < 0;
        const isUpcoming = offset > 0;
        const isMobile = isMobileWorksLayout();
        const isMobileVisible = isMobile && offset >= 0 && offset <= 3;
        const parkedX = offset < 0 ? '-64vw' : '64vw';
        const parkedRotate = offset < 0 ? '-2.8deg' : '2.8deg';

        card.classList.toggle('is-active', isActive);
        card.classList.toggle('is-past', isPast);
        card.classList.toggle('is-upcoming', isUpcoming);
        card.style.setProperty('--offset', String(offset));
        card.style.setProperty('--abs-offset', String(absOffset));
        card.style.setProperty('--depth', String(depth));
        card.style.setProperty('--stack-order', String(isMobile ? 1000 - Math.max(offset, 0) : 1000 - Math.round(absOffset * 20)));
        card.style.opacity = isActive || isMobileVisible ? String(isActive ? 1 : Math.max(0.38, 0.78 - offset * 0.14)) : '0';
        card.style.pointerEvents = isActive ? 'auto' : 'none';
        card.style.transform = isMobile
          ? `translate(-50%, calc(-50% + ${Math.max(offset, 0) * 0.72}rem)) rotate(${Math.max(offset, 0) * -1.1}deg) scale(${1 - Math.max(offset, 0) * 0.035})`
          : isActive
            ? 'translate(-50%, -50%) rotate(0deg) scale(1)'
            : `translate(calc(-50% + ${parkedX}), -50%) rotate(${parkedRotate}) scale(0.985)`;
        card.style.visibility = isActive || isMobileVisible ? 'visible' : 'hidden';
      });
    }

    function updateWorksStack() {
      if (!worksCards.length) return;
      renderWorksStack(visualWorkProgress);
      syncWorksMeta();
      const activeCard = worksCards[activeWorkIndex];

      worksCards.forEach((card, index) => {
        if (index !== activeWorkIndex) {
          const video = card.querySelector('video') as HTMLVideoElement | null;
          const image = card.querySelector('img') as HTMLImageElement | null;
          video?.style.removeProperty('opacity');
          image?.style.removeProperty('opacity');
          card.classList.remove('is-playing');
        }
      });

      stopWorksVideos(activeCard);
    }

    function setActiveWorkIndex(index: number) {
      const nextIndex = Math.min(Math.max(index, 0), worksCards.length - 1);
      if (nextIndex === activeWorkIndex) return;
      activeWorkIndex = nextIndex;
      updateWorksStack();
    }

    function setWorksProgress(progress: number) {
      targetWorkProgress = Math.min(Math.max(progress, 0), worksCards.length - 1);
      visualWorkProgress = targetWorkProgress;
      const nextIndex = Math.min(Math.floor(targetWorkProgress + 0.0001), worksCards.length - 1);
      const stepProgress = nextIndex >= worksCards.length - 1 ? 1 : targetWorkProgress - nextIndex;
      worksSection?.style.setProperty('--work-step-progress', String(Math.min(Math.max(stepProgress, 0), 1)));
      setActiveWorkIndex(nextIndex);
    }

    function getWorksSectionTop() {
      if (!worksSection) return 0;
      return worksSection.offsetTop;
    }

    function getWorksTravelDistance() {
      if (!worksSection) return 1;
      const introHold = getWorksIntroHoldDistance();
      return Math.max(1, worksSection.offsetHeight - getInteractionViewportHeight() - introHold);
    }

    function syncWorksStackToScroll() {
      if (!worksSection || !worksCards.length) return;
      const introHold = getWorksIntroHoldDistance();
      const progress = (window.scrollY - getWorksSectionTop() - introHold) / getWorksTravelDistance();
      const clampedProgress = Math.min(Math.max(progress, 0), 1);
      setWorksProgress(clampedProgress * (worksCards.length - 1));
    }

    function requestWorksScrollSync() {
      if (worksSection && !isNearInteractiveSection(worksSection)) return;
      if (worksScrollRaf) return;
      worksScrollRaf = window.requestAnimationFrame(() => {
        worksScrollRaf = undefined;
        syncWorksStackToScroll();
      });
    }

    function normalizeWheelDelta(event: WheelEvent) {
      if (event.deltaMode === 1) return event.deltaY * 16;
      if (event.deltaMode === 2) return event.deltaY * window.innerHeight;
      return event.deltaY;
    }

    function handleWorksWheel(event: WheelEvent) {
      if (!worksSection || !worksCards.length || window.innerWidth < 900) return;
      const sectionTop = getWorksSectionTop();
      const sectionBottom = sectionTop + worksSection.offsetHeight - window.innerHeight;
      const scrollY = window.scrollY;
      const rawDelta = normalizeWheelDelta(event);
      const isInsideWorks = scrollY >= sectionTop - 2 && scrollY <= sectionBottom + 2;
      const isLeavingUp = scrollY <= sectionTop + 2 && rawDelta < 0;
      const isLeavingDown = scrollY >= sectionBottom - 2 && rawDelta > 0;

      if (!isInsideWorks || isLeavingUp || isLeavingDown || Math.abs(rawDelta) < 1) return;

      event.preventDefault();
      const maxStep = Math.max(36, Math.min(window.innerHeight * 0.09, 72));
      const cappedDelta = Math.sign(rawDelta) * Math.min(Math.abs(rawDelta), maxStep);
      const nextY = Math.min(Math.max(scrollY + cappedDelta, sectionTop), sectionBottom);
      window.scrollTo({ top: nextY, behavior: 'auto' });
      requestWorksScrollSync();
    }

    function scrollToWorkIndex(index: number) {
      if (!worksSection || !worksCards.length) return;
      const targetIndex = Math.min(Math.max(index, 0), worksCards.length - 1);
      if (isMobileWorksLayout()) {
        setActiveWorkIndex(targetIndex);
        return;
      }
      const ratio = worksCards.length > 1 ? targetIndex / (worksCards.length - 1) : 0;
      const introHold = getWorksIntroHoldDistance();
      const targetY = getWorksSectionTop() + introHold + getWorksTravelDistance() * ratio;
      window.scrollTo({ top: targetY, behavior: 'smooth' });
      setWorksProgress(targetIndex);
      setActiveWorkIndex(targetIndex);
    }

    function toggleWorksVideo(card: HTMLElement) {
      if (!card.classList.contains('is-active') || card.dataset.workKind !== 'video') return;
      const video = card.querySelector('video') as HTMLVideoElement | null;
      if (!video) return;
      if (card.dataset.videoLoading === 'true') return;
      stopWorksVideos(card);
      video.controls = true;
      if (video.paused) {
        if (video.readyState === 0) video.load();
        video.muted = false;
        video.removeAttribute('muted');
        video.volume = Math.max(video.volume || 0, 0.85);
        const image = card.querySelector('img') as HTMLImageElement | null;
        card.dataset.videoLoading = 'true';

        const revealVideo: EventListener = () => {
          pendingWorksVideoReveals.delete(video);
          delete card.dataset.videoLoading;
          if (video.paused || !card.classList.contains('is-active')) return;
          video.style.setProperty('opacity', '1', 'important');
          image?.style.setProperty('opacity', '0', 'important');
          card.classList.add('is-playing');
        };
        pendingWorksVideoReveals.set(video, revealVideo);
        video.addEventListener('playing', revealVideo, { once: true });

        video.play().catch((error) => {
          // 旧一轮 play() 的异步失败不得打断同一卡片上已经开始的新一轮播放。
          if (pendingWorksVideoReveals.get(video) !== revealVideo) return;
          card.dataset.videoError = error?.name || 'play-failed';
          restoreWorksVideoPoster(card, video);
        });
      } else {
        video.pause();
        restoreWorksVideoPoster(card, video);
      }
    }

    function handleInteractiveResize() {
      const widthDelta = Math.abs(window.innerWidth - stableMobileViewportWidth);
      const heightDelta = Math.abs(window.innerHeight - stableMobileViewportHeight);
      const isMobileAddressBarResize = window.innerWidth < 900 && widthDelta <= 8 && heightDelta > 0;

      refreshStableViewportSize();
      applyWorksViewportMetrics();
      if (isMobileAddressBarResize) return;

      if (!isMobileHomeFallback()) {
        setupTimelineGeometry();
        requestTimelineScrollSync();
        requestWorksScrollSync();
      } else {
        releaseTimelineWorldSize();
        activateMobileTimelineFallback();
        updateWorksStack();
      }
    }

    function activateMobileTimelineFallback() {
      stopTimelineMotion();
      hoveredTimelineIndex = -1;
      chronologySection?.style.setProperty('--timeline-progress', '1');
      timelineNodes.forEach((node) => {
        node.classList.remove('is-current');
        node.classList.add('is-active');
      });
      if (timelineCurrent) timelineCurrent.textContent = String(timelineNodes.length).padStart(2, '0');
    }

    if (chronologySection) {
      bindTimelineNodeFocus();
      if (isMobileHomeFallback()) {
        releaseTimelineWorldSize();
        activateMobileTimelineFallback();
      } else {
        setupTimelineGeometry();
        setTimelineTarget(getTimelineRevealProgress(), true);
        window.addEventListener('scroll', requestTimelineScrollSync, { passive: true });
      }
    }

    if (worksCards.length) {
      worksSection?.style.setProperty('--works-count', String(worksCards.length));
      applyWorksViewportMetrics();
      updateWorksStack();
      if (!isMobileWorksLayout()) {
        syncWorksStackToScroll();
        window.addEventListener('scroll', requestWorksScrollSync, { passive: true });
        window.addEventListener('wheel', handleWorksWheel, { passive: false });
      }

      worksCategories.forEach((button) => {
        button.addEventListener('click', () => {
          if (button.getAttribute('aria-disabled') === 'true') return;
          const category = button.dataset.workCategory;
          const targetIndex = worksCards.findIndex((card) => card.dataset.workCategory === category);
          if (targetIndex < 0) return;
          scrollToWorkIndex(targetIndex);
        });
      });

      worksCards.forEach((card) => {
        const playButton = card.querySelector('.works-play') as HTMLButtonElement | null;
        playButton?.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          toggleWorksVideo(card);
        });

        card.addEventListener('click', (event) => {
          const target = event.target as HTMLElement;
          if (target.closest('a') || target.closest('video')) return;
          if (isMobileWorksLayout() && card.dataset.workKind !== 'video') {
            setActiveWorkIndex((activeWorkIndex + 1) % worksCards.length);
            return;
          }
          toggleWorksVideo(card);
        });
      });

      let worksTouchStartX = 0;
      let worksTouchStartY = 0;
      worksStage?.addEventListener('touchstart', (event) => {
        const touch = event.touches[0];
        if (!touch) return;
        worksTouchStartX = touch.clientX;
        worksTouchStartY = touch.clientY;
      }, { passive: true });

      worksStage?.addEventListener('touchend', (event) => {
        if (!isMobileWorksLayout()) return;
        const touch = event.changedTouches[0];
        if (!touch) return;
        const deltaX = touch.clientX - worksTouchStartX;
        const deltaY = touch.clientY - worksTouchStartY;
        if (Math.abs(deltaX) < 42 || Math.abs(deltaX) < Math.abs(deltaY) * 1.15) return;
        setActiveWorkIndex(activeWorkIndex + (deltaX < 0 ? 1 : -1));
      }, { passive: true });
    }

    if (chronologySection || worksCards.length) {
      window.addEventListener('resize', handleInteractiveResize);
    }

  </script>

  <script type="module" is:inline>
    const profileModelPanel = document.querySelector('.profile-model-panel');
    const profileModelCanvas = document.getElementById('profile-model-canvas');

    if (profileModelPanel && profileModelCanvas && !window.matchMedia('(max-width: 899px)').matches) {
      let modelLoadStarted = false;

      const initProfileModel = async () => {
        if (modelLoadStarted) return;
        modelLoadStarted = true;

        try {
          const THREE = await import('three');
          const { OrbitControls } = await import('three/addons/controls/OrbitControls.js');
          const { GLTFLoader } = await import('three/addons/loaders/GLTFLoader.js');

          const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 100);
      camera.position.set(3.6, 2.2, 5.4);

      const renderer = new THREE.WebGLRenderer({
        alpha: true,
        antialias: true,
        canvas: profileModelCanvas,
        powerPreference: 'high-performance'
      });
      renderer.setClearColor(0x000000, 0);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.8));
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      // 曝光由下面的 applyLightingTheme() 按主题统一设置（深色 1.03 / 浅色 1.02）

      // 模型自身没有材质定义（GLTFLoader 补的是 metalness 1 / roughness 1 的纯白材质），
      // 没有环境贴图时金属度只会吃掉漫反射，整只着陆器就是一团发白的平面。
      // 这里自制一张「影棚」等距柱状贴图：上边缘是天顶、横向是方位角，画上的亮块就是空中的灯。
      // 金属切面正是靠反射这些明暗块才分得出层次，均匀的室内环境只会把它照平。
      // 方位角 0° 落在贴图 u = 0.75 处，配合 frame() 里的 environmentRotation，
      // 渲染时正好停在屏幕右侧 —— 与主光同侧，反光才不会和灯光互相打架。
      function makeStudioEnvTexture(size = 1024) {
        const width = size;
        const height = size / 2;
        const surface = document.createElement('canvas');
        surface.width = width;
        surface.height = height;
        const paint = surface.getContext('2d');

        // 四周压到接近全黑：只有几块灯是有亮度的，金属才有干净的「亮面—暗面」可反射，
        // 环境整体一灰，再强的灯也会被糊掉（这是之前发白的根源）
        const background = paint.createLinearGradient(0, 0, 0, height);
        background.addColorStop(0, '#0d1725');
        background.addColorStop(0.46, '#050a12');
        background.addColorStop(1, '#02040a');
        paint.fillStyle = background;
        paint.fillRect(0, 0, width, height);

        // 画面上的一点 = 一个方向：cx 是方位角（0° 屏幕右方），cy 是仰角（正上方为天顶）
        const uOf = (azimuthDeg) => 0.5 + (90 - azimuthDeg) / 360;
        const vOf = (elevationDeg) => 0.5 - elevationDeg / 180;

        function lightBox(cx, cy, rx, ry, color, alpha) {
          paint.save();
          paint.globalAlpha = alpha;
          paint.translate(cx * width, cy * height);
          paint.scale(rx * width, ry * height);
          const glow = paint.createRadialGradient(0, 0, 0, 0, 0, 1);
          glow.addColorStop(0, color);
          glow.addColorStop(0.5, color);
          glow.addColorStop(1, 'rgba(0, 0, 0, 0)');
          paint.fillStyle = glow;
          paint.beginPath();
          paint.arc(0, 0, 1, 0, Math.PI * 2);
          paint.fill();
          paint.restore();
        }

        // 贴图首尾相接，靠近接缝的灯要补画到另一侧，否则会在 u = 0 处被切断
        function light(azimuthDeg, elevationDeg, rx, ry, color, alpha) {
          const cx = uOf(azimuthDeg);
          const cy = vOf(elevationDeg);
          lightBox(cx, cy, rx, ry, color, alpha);
          if (cx - rx < 0) lightBox(cx + 1, cy, rx, ry, color, alpha);
          if (cx + rx > 1) lightBox(cx - 1, cy, rx, ry, color, alpha);
        }

        // 右侧主柔光箱：一块不太大的白灯 + 更小更亮的内芯；
        // 尺寸必须克制，铺太大整机都会变成一片白，暗面根本留不下来
        light(0, 32, 0.085, 0.14, '#ffffff', 0.62);
        light(0, 30, 0.035, 0.06, '#ffffff', 1);
        light(34, 22, 0.055, 0.11, '#eaf4ff', 0.22); // 主光右上方垫一小块，亮面不至于断得太生硬
        // 左侧冷光板：小、暗、饱和度高，暗面那条蓝边才够纯；
        // 它一旦又大又亮，左右亮度就抵消了，整机立刻发闷
        light(180, 20, 0.07, 0.13, '#5fb6ff', 0.5);
        // 背后顶光：给背面切面留一点亮度，压得很低以免吃掉暗部
        light(104, 42, 0.11, 0.14, '#a8d4ff', 0.28);
        // 一点饱和的暖色点缀，免得整机只剩冷调
        light(288, 6, 0.06, 0.1, '#ffae5e', 0.34);
        // 地面反弹，托住下半身
        light(0, -42, 0.36, 0.13, '#2c4a68', 0.38);
        light(180, -38, 0.32, 0.12, '#243c56', 0.38);

        const texture = new THREE.CanvasTexture(surface);
        texture.mapping = THREE.EquirectangularReflectionMapping;
        texture.colorSpace = THREE.SRGBColorSpace;
        const generator = new THREE.PMREMGenerator(renderer);
        const envMap = generator.fromEquirectangular(texture).texture;
        texture.dispose();
        generator.dispose();
        return envMap;
      }

      scene.environment = makeStudioEnvTexture();

      // 浅色底比深色底要反射得更亮才不会发灰，两套主题各给一组光比；
      // 主光与边光的强度也分主题：浅色面板本身更亮，光源不跟上就压不住
      const themeLighting = {
        dark: { exposure: 1.03, envIntensity: 1.45, hemisphere: 0.05, key: 2.15, rim: 1.55, glowOpacity: 0.34 },
        light: { exposure: 1.02, envIntensity: 1.15, hemisphere: 0.05, key: 2.5, rim: 1.9, glowOpacity: 0.14 },
      };
      const modelMaterials = [];
      let glowBaseOpacity = themeLighting.dark.glowOpacity;
      let keyBaseIntensity = themeLighting.dark.key;
      let rimBaseIntensity = themeLighting.dark.rim;

      const controls = new OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;
      controls.dampingFactor = 0.08;
      controls.enablePan = false;
      controls.minDistance = 3.4;
      controls.maxDistance = 9;
      controls.autoRotate = true;
      controls.autoRotateSpeed = 0.72;

      // 光组挂在相机上：用相机空间坐标描述光源位置（+X 屏幕右、+Y 屏幕上、-Z 屏幕里），
      // 这样 OrbitControls 自转或用户拖拽时，主光始终停在屏幕右侧，而不是绕到模型背后。
      const lightRig = new THREE.Group();
      lightRig.name = 'profile-light-rig';
      camera.add(lightRig);
      scene.add(camera); // 相机要进场景图，挂在它下面的光源才会跟着更新世界矩阵

      // 方向光的瞄准点放在相机正前方这么远处，约等于模型中心的距离
      const RIG_AIM_DISTANCE = 7.2;

      // 方位角 0° 在相机正前方，正值为屏幕右侧；仰角正值为上
      function rigPosition(azimuthDeg, elevationDeg, distance) {
        const azimuth = THREE.MathUtils.degToRad(azimuthDeg);
        const elevation = THREE.MathUtils.degToRad(elevationDeg);
        const horizontal = Math.cos(elevation) * distance;
        return new THREE.Vector3(
          Math.sin(azimuth) * horizontal,
          Math.sin(elevation) * distance,
          Math.cos(azimuth) * horizontal - RIG_AIM_DISTANCE
        );
      }

      // 瞄准点也放进光组：光照方向只取决于两者在相机空间的相对关系，
      // 所以拖拽、缩放都不会改变打光角度，只改变从哪个角度看这只「被照亮」的模型
      function makeRigLight(color, intensity, azimuthDeg, elevationDeg, distance) {
        const light = new THREE.DirectionalLight(color, intensity);
        light.position.copy(rigPosition(azimuthDeg, elevationDeg, distance));
        const aim = new THREE.Object3D();
        aim.position.set(0, 0, -RIG_AIM_DISTANCE);
        light.target = aim;
        light.userData.basePosition = light.position.clone();
        lightRig.add(aim);
        lightRig.add(light);
        return light;
      }

      // 主光：屏幕右上方最亮最纯的一束白光，负责切面之间的明暗分层
      const keyLight = makeRigLight(0xffffff, keyBaseIntensity, 38, 28, 6.4);

      // 左侧冷边光：饱和度很足的冷蓝，在暗面上勾出那条蓝边
      const rimLight = makeRigLight(0x7cc4ff, rimBaseIntensity, -70, 12, 7.2);

      // 背后顶光：给背面切面留一条细亮边，强度压低，免得把暗部对比吃掉
      const backLight = makeRigLight(0x6cb4ff, 0.5, 166, 32, 7.6);

      // 底部反弹光：只托住着陆支架与底面，几乎不参与塑形
      const bounceLight = makeRigLight(0x9ec6ea, 0.3, -6, -44, 6.8);

      // 镜头侧点光：贴着右前方，模型自转时在金属切面上扫出一颗流动的高光
      const glintLight = new THREE.PointLight(0xffffff, 7, 26, 2);
      glintLight.position.copy(rigPosition(30, 8, 4.2));
      glintLight.userData.basePosition = glintLight.position.clone();
      lightRig.add(glintLight);

      // 环境补光：只用来兜住暗部下限，明暗对比交给主光与边光
      const fillLight = new THREE.HemisphereLight(0xacdbfb, 0x040a12, 0.045);
      scene.add(fillLight);

      const grid = new THREE.GridHelper(5.6, 18, 0xacdbfb, 0x1d3a4d);
      grid.position.y = -1.35;
      grid.material.transparent = true;
      grid.material.opacity = 0.26;
      scene.add(grid);

      // 径向渐变贴图：辉光与接触阴影都用它，省掉后处理管线
      function makeRadialTexture(stops) {
        const size = 256;
        const surface = document.createElement('canvas');
        surface.width = size;
        surface.height = size;
        const paint = surface.getContext('2d');
        const gradient = paint.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
        stops.forEach(([offset, color]) => gradient.addColorStop(offset, color));
        paint.fillStyle = gradient;
        paint.fillRect(0, 0, size, size);
        const texture = new THREE.CanvasTexture(surface);
        texture.colorSpace = THREE.SRGBColorSpace;
        return texture;
      }

      // 模型背后的蓝色辉光：随呼吸轻微明灭，让金属边缘像在发光
      const backdropGlow = new THREE.Sprite(new THREE.SpriteMaterial({
        map: makeRadialTexture([
          [0, 'rgba(172, 219, 251, 0.85)'],
          [0.42, 'rgba(122, 178, 226, 0.32)'],
          [1, 'rgba(4, 10, 16, 0)'],
        ]),
        color: 0xacdbfb,
        transparent: true,
        opacity: 0.42,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
      }));
      backdropGlow.position.set(0, 0.25, -2.35);
      backdropGlow.scale.set(5.6, 5.6, 1);
      scene.add(backdropGlow);

      // 假接触阴影：贴在支架脚下，把模型「按」到地面上（不占一张阴影贴图）
      const contactShadow = new THREE.Mesh(
        new THREE.PlaneGeometry(3.6, 3.6),
        new THREE.MeshBasicMaterial({
          map: makeRadialTexture([
            [0, 'rgba(0, 0, 0, 0.95)'],
            [0.5, 'rgba(0, 0, 0, 0.42)'],
            [0.78, 'rgba(0, 0, 0, 0.12)'],
            [1, 'rgba(0, 0, 0, 0)'],
          ]),
          color: 0x000000,
          transparent: true,
          opacity: 0.58,
          depthWrite: false,
        })
      );
      contactShadow.rotation.x = -Math.PI / 2;
      contactShadow.position.y = -1.34;
      scene.add(contactShadow);

      let modelRoot = null;
      let frameId = 0;
      let isVisible = false;
      let lightClock = 0;

      function currentThemeLighting() {
        return (document.documentElement.dataset.theme || 'dark') === 'light'
          ? themeLighting.light
          : themeLighting.dark;
      }

      // 曝光、反射强度、辉光浓淡、主光/边光亮度都跟着主题走；
      // 模型材质是异步加载的，所以两处都要能重复调用
      function applyLightingTheme() {
        const preset = currentThemeLighting();
        renderer.toneMappingExposure = preset.exposure;
        fillLight.intensity = preset.hemisphere;
        keyLight.intensity = preset.key;
        rimLight.intensity = preset.rim;
        keyBaseIntensity = preset.key;
        rimBaseIntensity = preset.rim;
        glowBaseOpacity = preset.glowOpacity;
        backdropGlow.material.opacity = preset.glowOpacity;
        modelMaterials.forEach((material) => {
          material.envMapIntensity = preset.envIntensity;
          material.needsUpdate = true;
        });
      }

      applyLightingTheme();

      // 顶栏的主题开关会改 html[data-theme]，这里跟着重算 3D 光比
      new MutationObserver(() => applyLightingTheme()).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });

      function resizeProfileModel() {
        const rect = profileModelPanel.getBoundingClientRect();
        const width = Math.max(1, Math.floor(rect.width));
        const height = Math.max(1, Math.floor(rect.height));
        renderer.setSize(width, height, false);
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
      }

      function frame() {
        if (!isVisible) {
          frameId = 0;
          return;
        }

        lightClock += 0.016;

        if (modelRoot) {
          modelRoot.rotation.y += 0.0022;
        }

        // 光源在相机空间里小幅漂移 + 边光呼吸：高光会流动，但整束光始终留在屏幕右侧
        const keyBase = keyLight.userData.basePosition;
        keyLight.position.set(
          keyBase.x + Math.sin(lightClock * 0.33) * 0.5,
          keyBase.y + Math.cos(lightClock * 0.24) * 0.34,
          keyBase.z + Math.sin(lightClock * 0.19) * 0.3
        );
        keyLight.intensity = keyBaseIntensity * (1 + Math.sin(lightClock * 0.5) * 0.05);
        rimLight.intensity = rimBaseIntensity * (1 + Math.cos(lightClock * 0.42 + 1.1) * 0.08);
        const glintBase = glintLight.userData.basePosition;
        glintLight.position.set(
          glintBase.x + Math.sin(lightClock * 0.37 + 0.6) * 0.7,
          glintBase.y + Math.cos(lightClock * 0.29) * 0.4,
          glintBase.z + Math.sin(lightClock * 0.23) * 0.5
        );
        // 辉光按主题基准值做呼吸，浅色主题几乎看不出，深色主题才明显
        backdropGlow.material.opacity = glowBaseOpacity * (1 + Math.sin(lightClock * 0.45) * 0.24);
        const glowScale = 5.6 + Math.sin(lightClock * 0.45) * 0.22;
        backdropGlow.scale.set(glowScale, glowScale, 1);

        controls.update();

        // 环境贴图里的亮块跟着相机一起转：否则相机自转到某个角度时，
        // 反光会跑到屏幕左侧，与「光源固定在右侧」自相矛盾。
        // 着色器里取样方向是 envMapRotation * worldNormal，PMREM 贴图还会把欧拉角取负，
        // 于是「世界方位角 = 贴图方位角 + environmentRotation.y」，+90° 正是屏幕右侧。
        scene.environmentRotation.y = Math.atan2(camera.position.x, camera.position.z) + Math.PI / 2;

        renderer.render(scene, camera);
        frameId = window.requestAnimationFrame(frame);
      }

      function startProfileModel() {
        if (frameId) return;
        isVisible = true;
        resizeProfileModel();
        frame();
      }

      function stopProfileModel() {
        isVisible = false;
      }

      new GLTFLoader().load(
        '/models/lunar-lander.glb',
        (gltf) => {
          modelRoot = gltf.scene;
          const bounds = new THREE.Box3().setFromObject(modelRoot);
          const size = bounds.getSize(new THREE.Vector3());
          const center = bounds.getCenter(new THREE.Vector3());
          const maxAxis = Math.max(size.x, size.y, size.z) || 1;

          modelRoot.position.sub(center);
          modelRoot.scale.setScalar(2.45 / maxAxis);
          modelRoot.rotation.set(-0.08, 0.38, 0);

          // 摆好姿态后再算一次包围盒，把接触阴影贴到支架脚下
          const fitted = new THREE.Box3().setFromObject(modelRoot);
          contactShadow.position.y = fitted.min.y - 0.01;

          modelRoot.traverse((node) => {
            if (!node.isMesh) return;
            node.castShadow = true;
            node.receiveShadow = true;
            node.geometry?.computeVertexNormals?.();

            const materials = Array.isArray(node.material) ? node.material : [node.material];
            materials.forEach((material) => {
              if (!material) return;
              material.flatShading = true;
              // 放开到「抛光金属」区间：切面之间靠反射环境贴图拉开明暗，
              // 压得太钝（metalness 低 + roughness 高）反而会重新糊成一片白。
              material.metalness = Math.min(Math.max(material.metalness ?? 0.7, 0.66), 0.74);
              material.roughness = Math.min(Math.max(material.roughness ?? 0.38, 0.34), 0.42);
              material.needsUpdate = true;
              modelMaterials.push(material);
            });
          });

          // 材质到位后套用当前主题的反射强度
          applyLightingTheme();

          scene.add(modelRoot);
          profileModelCanvas.dataset.modelReady = 'true';
          if (isVisible) startProfileModel();
        },
        undefined,
        () => {
          profileModelCanvas.dataset.modelReady = 'error';
        }
      );

      const observer = new IntersectionObserver((entries) => {
        const entry = entries[0];
        if (entry?.isIntersecting) {
          startProfileModel();
        } else {
          stopProfileModel();
        }
      }, { threshold: 0.08 });

      observer.observe(profileModelPanel);
      window.addEventListener('resize', resizeProfileModel);
          resizeProfileModel();
        } catch {
          profileModelCanvas.dataset.modelReady = 'error';
        }
      };

      const modelLoadObserver = new IntersectionObserver(([entry]) => {
        if (!entry?.isIntersecting) return;
        modelLoadObserver.disconnect();
        void initProfileModel();
      }, { rootMargin: '1200px 0px' });

      modelLoadObserver.observe(profileModelPanel);
    }
  </script>

